# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Frontend & CORS Configuration
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Set your MongoDB Atlas or local connection string here)
MONGODB_URI=mongodb://localhost:27017/civicfix_ai

# JWT Authentication Configuration (Must be at least 32 characters in production)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Cloudinary Media Storage Configuration (Phase 5)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI Configuration (Phase 6 & Phase 15)
GEMINI_API_KEY=your_gemini_api_key

# Email Notification Configuration (Phase 13: Nodemailer SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=notifications@civicfix.city
EMAIL_FROM_NAME="CivicFix AI Alerts"
