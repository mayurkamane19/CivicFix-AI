# CivicFix AI - Staging Environment Configuration (.env.staging.example)
# Copy this template to backend/.env when preparing staging deployment.
# NEVER commit the actual secrets or production keys to version control.

# Server Execution Environment
PORT=5000
NODE_ENV=production

# Frontend Origin & CORS Allowlist
# For staging, specify your deployed Vercel frontend URL(s) comma-separated
CORS_ORIGIN=https://civicfix-ai-staging.vercel.app,http://localhost:5173
FRONTEND_URL=https://civicfix-ai-staging.vercel.app

# MongoDB Atlas Staging Connection String
# Target Database: civicfix_staging
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://civicfix_staging_user:<STAGING_PASSWORD>@<CLUSTER_URL>.mongodb.net/civicfix_staging?retryWrites=true&w=majority

# JWT Authentication Configuration
# CRITICAL: Production/Staging requires a cryptographically strong secret >= 32 characters
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_staging_2026
JWT_EXPIRES_IN=1d

# Cloudinary Media Storage (Staging media bucket)
CLOUDINARY_CLOUD_NAME=your_staging_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_staging_cloudinary_api_key
CLOUDINARY_API_SECRET=your_staging_cloudinary_api_secret

# Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key

# Web Push Notification Configuration (VAPID)
# Staging Web Push credentials
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@civicfix.city

# Transactional Email Configuration (Nodemailer SMTP)
# Set EMAIL_ENABLED=true only when valid SMTP credentials are provided
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
EMAIL_FROM=alerts@civicfix.city
EMAIL_FROM_NAME="CivicFix AI Staging"
